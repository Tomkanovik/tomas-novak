---
import '../styles/app.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "Tomáš Novák | Freelance Full-Stack Web Developer Brno",
	description = "Profesionální freelance full-stack webový vývojář z Brna. Tvorba moderních webových aplikací na míru s důrazem na výkon, přístupnost a čistý kód.",
	image = "/favicon.svg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="cs" class="light scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<!-- Structured Data -->
		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "ProfessionalService",
				"name": "Tomáš Novák - Freelance Full-Stack Web Developer",
				"image": "https://tnovak.eu/favicon.svg",
				"@id": "https://tnovak.eu",
				"url": "https://tnovak.eu",
				"telephone": "+420722605230",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "Bučkova 3a",
					"addressLocality": "Brno",
					"postalCode": "627 00",
					"addressCountry": "CZ"
				},
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": 49.1824,
					"longitude": 16.6668
				},
				"openingHoursSpecification": {
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": [
						"Monday",
						"Tuesday",
						"Wednesday",
						"Thursday",
						"Friday"
					],
					"opens": "09:00",
					"closes": "18:00"
				},
				"sameAs": [
					"https://www.linkedin.com/in/tom%C3%A1%C5%A1-nov%C3%A1k-146777293/"
				],
				"priceRange": "$$$"
			}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-25..0" rel="stylesheet"/>
	</head>
	<body class="selection:bg-primary/10 selection:text-primary">
		<slot />
	</body>
</html>