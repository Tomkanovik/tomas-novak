---
import kontrolaImg from '../assets/kontrola-vytapeni.png';
import petakImg from '../assets/petakphotography.png';
import flytimeImg from '../assets/flytime.png';
import printfullyImg from '../assets/printfully3d.png';

const projects = [
  {
    title: "Kontrola systému vytápění",
    description: "Specializovaný web pro revize a zákonné kontroly otopných soustav s důrazem na legislativní shodu.",
    tags: ["Astro", "Tailwind CSS", "Legislativa"],
    image: kontrolaImg.src,
    link: "https://www.kontrola-systemu-vytapeni.cz/"
  },
  {
    title: "Petak Photography",
    description: "Elegantní portfolio pro profesionálního fotografa s důrazem na vizuální prezentaci a rychlost.",
    tags: ["Photography", "Portfolio", "Web Design"],
    image: petakImg.src,
    link: "https://www.petakphotography.cz/"
  },
  {
    title: "FlyTime",
    description: "E-shop s komponenty pro FPV drony a závodění.",
    tags: ["E-commerce", "FPV", "Drones"],
    image: flytimeImg.src,
    link: "https://www.flytime.cz/"
  },
  {
    title: "Printfully3D",
    description: "E-shop a platforma pro prodej RC modelů pro 3D tiskárny.",
    tags: ["E-commerce", "RC Models", "3D Printing"],
    image: printfullyImg.src,
    link: "https://www.printfully3d.com/"
  }
];
---
<section class="wrapper py-32" id="projects">
  <div class="repel items-end mb-16">
    <div>
      <h2 class="text-4xl font-bold tracking-tight text-slate-900 mb-4">Vybrané projekty</h2>
      <div class="h-1 w-20 bg-primary"></div>
    </div>
  </div>
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-12">
    {projects.map((project) => (
      <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-card group block">
        <div class="project-card__image-container">
          <img src={project.image} alt={project.title} class="project-card__image" />
        </div>
        <div class="project-card__content">
          <div class="flex justify-between items-start mb-4">
            <h3 class="project-card__title">{project.title}</h3>
            <div class="size-12 flex flex-shrink-0 items-center justify-center border border-slate-200 rounded-full group-hover:bg-primary group-hover:text-white group-hover:border-primary transition-all">
              <span class="material-symbols-outlined text-xl">open_in_new</span>
            </div>
          </div>
          <p class="project-card__description">{project.description}</p>
          <div class="project-card__tags">
            {project.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
