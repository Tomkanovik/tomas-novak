<section class="bg-slate-50 border-y border-slate-100 py-16" id="skills">
  <div class="wrapper">
    <h4 class="text-center text-[10px] font-bold tracking-[0.3em] uppercase text-slate-400 mb-10">Hlavní technologický stack</h4>
    <div class="repel justify-center gap-8 md:justify-between opacity-70 grayscale hover:grayscale-0 transition-all duration-500">
      <div class="flex items-center gap-2 group cursor-default">
        <span class="material-symbols-outlined text-primary group-hover:scale-110 transition-transform">code</span>
        <span class="text-lg font-semibold text-slate-700">TypeScript</span>
      </div>
      <div class="flex items-center gap-2 group cursor-default">
        <span class="material-symbols-outlined text-primary group-hover:scale-110 transition-transform">rebase_edit</span>
        <span class="text-lg font-semibold text-slate-700">React</span>
      </div>
      <div class="flex items-center gap-2 group cursor-default">
        <span class="material-symbols-outlined text-primary group-hover:scale-110 transition-transform">dns</span>
        <span class="text-lg font-semibold text-slate-700">Node.js</span>
      </div>
      <div class="flex items-center gap-2 group cursor-default">
        <span class="material-symbols-outlined text-primary group-hover:scale-110 transition-transform">database</span>
        <span class="text-lg font-semibold text-slate-700">PostgreSQL</span>
      </div>
      <div class="flex items-center gap-2 group cursor-default">
        <span class="material-symbols-outlined text-primary group-hover:scale-110 transition-transform">cloud</span>
        <span class="text-lg font-semibold text-slate-700">AWS</span>
      </div>
      <div class="flex items-center gap-2 group cursor-default">
        <span class="material-symbols-outlined text-primary group-hover:scale-110 transition-transform">architecture</span>
        <span class="text-lg font-semibold text-slate-700">Tailwind</span>
      </div>
    </div>
  </div>
</section>
