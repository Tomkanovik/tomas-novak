---
const skills = [
  { name: "React", icon: "rebase_edit" },
  { name: "Vue.js", icon: "change_history" },
  { name: "Next.js", icon: "layers" },
  { name: "TypeScript", icon: "code" },
  { name: "JavaScript", icon: "terminal" },
  { name: "HTML", icon: "html" },
  { name: "CSS", icon: "css" },
  { name: "Sass", icon: "style" },
  { name: "Java", icon: "coffee" },
  { name: "PHP", icon: "php" },
  { name: "Laravel", icon: "diamond" },
  { name: "Spring", icon: "eco" },
  { name: "SQL", icon: "database" },
  { name: "Elasticsearch", icon: "search" },
  { name: "Docker", icon: "package_2" },
  { name: "Kubernetes", icon: "grid_view" },
  { name: "WordPress", icon: "format_paint" },
  { name: "Liferay", icon: "hub" },
];
---
<section class="bg-slate-50 border-y border-slate-100 py-16" id="skills">
  <div class="wrapper">
    <h4 class="text-center text-[10px] font-bold tracking-[0.3em] uppercase text-slate-400 mb-10">Hlavní technologický stack</h4>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-8 gap-y-10 opacity-70 grayscale hover:grayscale-0 transition-all duration-500">
      {skills.map(skill => (
        <div class="flex items-center gap-3 group cursor-default">
          <span class="material-symbols-outlined text-primary group-hover:scale-110 transition-transform">{skill.icon}</span>
          <span class="text-lg font-semibold text-slate-700">{skill.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
