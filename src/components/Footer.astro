---
import Logo from './Logo.astro';
---
<footer class="bg-white py-16 border-t border-slate-100">
  <div class="wrapper">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <div class="flow" style="--flow-space: 1.5rem;">
        <Logo size="md" />
        <p class="text-slate-500 max-w-sm text-sm leading-relaxed">
          Full-stack vývojář zaměřený na moderní webové technologie a uživatelskou přívětivost.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        <div class="flow" style="--flow-space: 0.75rem;">
          <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400">Kontaktujte mě</h3>
          <ul class="flow" style="--flow-space: 0.5rem;">
            <li>
              <a href="mailto:info@tnovak.eu" class="text-slate-600 hover:text-primary transition-colors flex items-center gap-2 text-sm font-medium">
                <span class="material-symbols-outlined text-base">mail</span>
                info@tnovak.eu
              </a>
            </li>
            <li>
              <a href="tel:+420722605230" class="text-slate-600 hover:text-primary transition-colors flex items-center gap-2 text-sm font-medium">
                <span class="material-symbols-outlined text-base">call</span>
                +420 722 605 230
              </a>
            </li>
            <li class="text-slate-600 flex items-center gap-2 text-sm font-medium">
              <span class="material-symbols-outlined text-base">location_on</span>
              Adresa: Bučkova 3a, Brno 627 00
            </li>
            <li class="text-slate-600 flex items-center gap-2 text-sm font-medium">
              <span class="material-symbols-outlined text-base">fingerprint</span>
              IČO: 05876176
            </li>
          </ul>
        </div>
        <div class="flow" style="--flow-space: 0.75rem;">
          <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400">Sociální sítě</h3>
          <ul class="flow" style="--flow-space: 0.5rem;">
            <li>
              <a href="https://www.linkedin.com/in/tom%C3%A1%C5%A1-nov%C3%A1k-146777293/" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-primary transition-colors flex items-center gap-2 text-sm font-medium">
                <svg class="size-4 fill-current" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>LinkedIn</title><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-slate-100 repel">
      <div class="flex items-center gap-2">
        <div class="size-5 bg-primary/10 flex items-center justify-center rounded">
          <span class="material-symbols-outlined text-primary text-[12px]">copyright</span>
        </div>
        <span class="text-sm text-slate-500">2024 Tomáš Novák. Všechna práva vyhrazena.</span>
      </div>
      <div class="flex gap-8">
        <span class="text-[10px] font-bold tracking-widest uppercase text-slate-400">Status: Online</span>
      </div>
    </div>
  </div>
</footer>
