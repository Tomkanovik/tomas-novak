---
---
<section class="wrapper pt-32 pb-48">
  <div class="flex flex-col lg:flex-row items-center gap-24">
    <div class="flex-1 flow" style="--flow-space: 2.5rem;">
      <h1 class="text-6xl md:text-8xl font-bold leading-[1.05] tracking-tight text-slate-900">
        Vytvářím vysoce výkonné <span class="text-primary">webové zážitky</span> s precizností.
      </h1>
      <p class="text-2xl text-slate-500 max-w-2xl leading-relaxed">
        Full-stack vývojář specializující se na minimalistickou architekturu a robustní inženýrství. Zaměřen na výkon, přístupnost a čistý kód.
      </p>
      <div class="flex items-center gap-6 pt-4">
        <a href="#projects" class="btn btn-primary btn-md shadow-lg shadow-primary/20">
          Zobrazit projekty
        </a>
        <a href="/resume.pdf" class="btn btn-outline btn-md">
          Přečíst si životopis
        </a>
      </div>
    </div>
    <!-- Code Window Graphic -->
    <div class="flex-1 w-full flex justify-center lg:justify-end">
      <div class="code-window">
        <div class="code-window__header">
          <div class="code-window__title">portfolio.ts — Visual Studio Code</div>
          <div class="flex items-center">
            <button class="px-2 py-1 hover:bg-slate-200 transition-colors text-slate-400">
              <span class="material-symbols-outlined text-sm">remove</span>
            </button>
            <button class="px-2 py-1 hover:bg-slate-200 transition-colors text-slate-400">
              <span class="material-symbols-outlined text-[12px]">check_box_outline_blank</span>
            </button>
            <button class="px-2 py-1 hover:bg-red-500 hover:text-white transition-colors text-slate-400">
              <span class="material-symbols-outlined text-sm">close</span>
            </button>
          </div>
        </div>
        <div class="code-window__content">
          <div class="code-line">
            <span class="code-line__number">01</span>
            <span><span class="text-primary">import</span> &#123; Developer &#125; <span class="text-primary">from</span> <span class="text-emerald-600">'@core/types'</span>;</span>
          </div>
          <div class="code-line">
            <span class="code-line__number">02</span>
            <span>&nbsp;</span>
          </div>
          <div class="code-line">
            <span class="code-line__number">03</span>
            <span><span class="text-primary">const</span> portfolio: <span class="text-amber-500">Developer</span> = &#123;</span>
          </div>
          <div class="code-line">
            <span class="code-line__number">04</span>
            <span>&nbsp;&nbsp;name: <span class="text-emerald-600">'Tomáš Novák'</span>,</span>
          </div>
          <div class="code-line">
            <span class="code-line__number">05</span>
            <span>&nbsp;&nbsp;focus: [<span class="text-emerald-600">'Performance'</span>, <span class="text-emerald-600">'UI'</span>],</span>
          </div>
          <div class="code-line">
            <span class="code-line__number">06</span>
            <span>&nbsp;&nbsp;available: <span class="text-primary">true</span></span>
          </div>
          <div class="code-line">
            <span class="code-line__number">07</span>
            <span>&#125;;</span>
          </div>
          <div class="code-line mt-4">
            <span class="code-line__number">08</span>
            <span class="inline-block w-2 h-5 bg-primary/40"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
